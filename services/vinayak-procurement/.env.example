# Optional AI extraction. Without a key, local text/PDF/Excel extraction and assisted review remain available.
# Configure production secrets through Sites, never in the hosting manifest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional LOCAL Gmail connector. These values are read by Node commands only,
# not by the hosted Cloudflare app. Keep client secrets and tokens out of source.
# GMAIL_ENV_FILE=/absolute/path/to/private/.env
# Put the following in that external .env (or in your local .env.local):
# GMAIL_CLIENT_CREDENTIALS=/absolute/path/to/desktop-oauth-client.json
# GMAIL_TOKEN_PATH=/absolute/path/to/private/.credentials/gmail-token.json
# GMAIL_EXPECTED_EMAIL=
# Existing Client_ID / Client_Secret keys are supported and checked against JSON.
