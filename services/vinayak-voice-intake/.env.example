# Read the existing external file; never copy its secrets into the application.
VOICE_ENV_FILE=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
VOICE_USERS_CSV=
WHATSAPP_STORE_DIR=
VOICE_DATA_DIR=
VOICE_PORT=8767

# Official DeepSeek API. The existing spelling Deepseek_Api_Key is also accepted.
# deepseek-flash currently serves DeepSeek-V4.1-Flash-1017.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
